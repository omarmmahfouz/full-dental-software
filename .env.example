# Copy this file to ".env" and fill in the values.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Keep 0 on the real server.
DJANGO_DEBUG=0

# The addresses staff type in the browser: the server's LAN IP and/or name.
DJANGO_ALLOWED_HOSTS=192.168.1.10,cia-server,localhost,127.0.0.1
# Same addresses with http:// (needed for forms to be accepted).
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10,http://cia-server,http://localhost

# Database: "postgres" (recommended) or "sqlite" (single PC trial).
DB_ENGINE=postgres
DB_NAME=dental
DB_USER=dental
DB_PASSWORD=change-me-too
# "db" when using docker compose, "localhost" for a direct install.
DB_HOST=db
DB_PORT=5432

# Business rules
LATE_THRESHOLD_MINUTES=10
DEFAULT_APPOINTMENT_MINUTES=60
COMPLAINT_FOLLOW_UP_DAYS=2
DEFAULT_BRANCH_CODE=CIA
CURRENCY=EGP
MAX_UPLOAD_SIZE_MB=15
