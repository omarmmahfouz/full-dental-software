#: reading/rules.py:47
#, python-format
msgid ""
"This mobile has %(n)s digits: Egyptian mobiles have exactly 11 (e.g. "
"01001234567)."
msgstr ""
"هذا الرقم %(n)s رقمًا: الموبايل المصري 11 رقمًا بالضبط (مثل 01001234567)."

