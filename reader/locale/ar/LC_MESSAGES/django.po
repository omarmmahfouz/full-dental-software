msgid "Claude could not read it."
msgstr "Claude ما قدرش يقراها."

#: reading/checks.py:36
#, python-format
msgid "The two readings differ: %(a)s / %(b)s."
msgstr "القراءتين مختلفتين: %(a)s / %(b)s."

