# ---- The Paper Reader's settings (round 13; see README.md next to this file) ----
# start-windows.bat (or start-mac-linux.sh) writes a .env by itself on the first run; change it with Notepad.

# A long random text that keeps the logins safe (made by the start script). Never share it.
READER_SECRET_KEY=change-me-to-a-long-random-text

# The key from https://platform.claude.com (API keys). Only here, on this PC: never on WhatsApp, by e-mail or in a
# message. Start the reader again after changing it. Nothing is sent until the person in charge switches the
# reading on (Settings → Reading and the key).
# ANTHROPIC_API_KEY=sk-ant-...

# Who may open the reader: the clinic's network only (the private addresses, the default). "*" = everyone.
# READER_ALLOWED_NETWORKS=192.168.1.0/24
READER_ALLOWED_HOSTS=*

# Where the reader keeps its database, the scans and the packages (the "data" folder next to this file by default).
# The scans are patients' files: keep this folder on this PC only, and back it up.
# READER_DATA_DIR=D:\Paper Reader data
