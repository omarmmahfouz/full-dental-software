msgid "code"
msgstr "الكود"

#: apps/core/models.py:64
msgid "Short prefix used in file numbers, e.g. CIA."
msgstr "اختصار يستخدم في أرقام الملفات، مثل CIA."

#: apps/core/models.py:66 apps/dentists/forms.py:156
#: apps/dentists/models.py:61 apps/prescriptions/models.py:25
#: apps/purchasing/models.py:58 apps/reports/views.py:121
