msgid "address"
msgstr "العنوان"

#: apps/core/models.py:70
msgid "has a CBCT machine"
msgstr "يوجد جهاز CBCT"

#: apps/core/models.py:71
msgid ""
"A CBCT asked by a dentist here can then be marked as done in the clinic."
msgstr "الأشعة المقطعية التي يطلبها طبيب هنا يمكن تسجيلها كتمت في العيادة."

#: apps/core/models.py:74
msgid "Standard (light)"
msgstr "عادي (فاتح)"

#: apps/core/models.py:75
msgid "Elite (navy and gold)"
msgstr "فاخر (كحلي وذهبي)"

#: apps/core/models.py:79
msgid "file number prefix"
msgstr "بادئة رقم الملف"

#: apps/core/models.py:80
msgid "Empty = the code. e.g. EK gives the new files EK-00001."
msgstr "فاضي = الكود. مثلًا EK تخلي الملفات الجديدة EK-00001."

#: apps/core/models.py:81
msgid "line under the name"
msgstr "سطر تحت الاسم"

#: apps/core/models.py:82
msgid "Printed under the name, e.g. Specialist dental care."
msgstr "بيتطبع تحت الاسم، مثلًا: رعاية أسنان تخصصية."

#: apps/core/models.py:83
msgid "e-mail"
msgstr "البريد الإلكتروني"

#: apps/core/models.py:84
msgid "look of the screens"
msgstr "شكل الشاشات"

#: apps/core/models.py:85
msgid "The top bar, the buttons and the printed papers of this place."
msgstr "الشريط العلوي والأزرار والورق المطبوع للمكان ده."

#: apps/core/models.py:86
msgid "colour"
msgstr "اللون"

#: apps/core/models.py:87
msgid "Write the colour as # and 6 letters or digits, e.g. #1F6FB2."
msgstr "اكتب اللون بعلامة # و6 حروف أو أرقام، مثلًا #1F6FB2."

#: apps/core/models.py:89
msgid "e.g. #1F6FB2. Empty = the usual colour of the place."
msgstr "مثلًا #1F6FB2. فاضي = لون المكان المعتاد."

#: apps/core/models.py:90
msgid "logo"
msgstr "الشعار (اللوجو)"

#: apps/core/models.py:91
msgid "On the top bar, the login page and the printed papers of this place."
msgstr "على الشريط العلوي وصفحة الدخول والورق المطبوع للمكان ده."

#: apps/core/models.py:93
msgid "opens at"
msgstr "يفتح الساعة"

#: apps/core/models.py:94
msgid "Empty = the hours in the clinic options."
