#: apps/core/forms.py:139
msgid "Course candidates do not have access to the system."
msgstr "دارسو الكورسات ليس لهم دخول على النظام."

#: apps/core/health.py:84
msgid "The system runs in normal mode (not the test mode)"
msgstr "النظام شغال في الوضع العادي (مش وضع التجربة)"

#: apps/core/health.py:85
msgid ""
"DJANGO_DEBUG is off: errors show a short page, not the program's details."
msgstr "DJANGO_DEBUG مقفول: الأخطاء بتظهر صفحة قصيرة، مش تفاصيل البرنامج."

#: apps/core/health.py:86
msgid "Set DJANGO_DEBUG=0 in the .env file of the server and restart it."
msgstr "اكتب DJANGO_DEBUG=0 في ملف ‎.env على السيرفر وشغّله من جديد."

#: apps/core/health.py:88
msgid "The secret key is long and private"
msgstr "المفتاح السري طويل ومحفوظ"

#: apps/core/health.py:89
msgid "It signs the logins: keep the .env file only on the server."
msgstr "هو اللي بيوقّع الدخول: خلّي ملف ‎.env على السيرفر بس."

#: apps/core/health.py:90
msgid ""
"Write a long random DJANGO_SECRET_KEY in the .env file (the installer makes "
"one) and restart."
msgstr ""
"اكتب DJANGO_SECRET_KEY طويل وعشوائي في ملف ‎.env (برنامج التثبيت بيعمله) "
"وشغّل من جديد."

#: apps/core/health.py:92
msgid "Only the clinic's network can open the system"
msgstr "شبكة العيادة بس هي اللي تقدر تفتح النظام"

#: apps/core/health.py:93
msgid ""
"Devices outside the clinic's network are refused, even if the server is "
"opened to the internet by mistake."
msgstr ""
"الأجهزة اللي برّه شبكة العيادة بتترفض، حتى لو السيرفر اتفتح على الإنترنت "
"بالغلط."

#: apps/core/health.py:95
msgid ""
"ALLOWED_NETWORKS is \"*\": every address may try. Use it only behind HTTPS "
"and a VPN."
msgstr ""
"ALLOWED_NETWORKS = \"*\": أي عنوان يقدر يحاول. استخدمه بس ورا HTTPS و VPN."

#: apps/core/health.py:96
msgid "The server answers to its own names only"
msgstr "السيرفر بيرد على أساميه هو بس"

#: apps/core/health.py:97
msgid "ALLOWED_HOSTS lists the server's address and name."
msgstr "ALLOWED_HOSTS فيه عنوان السيرفر واسمه."

#: apps/core/health.py:98
msgid ""
"ALLOWED_HOSTS is \"*\": write the server's address and name in "
"DJANGO_ALLOWED_HOSTS."
msgstr "ALLOWED_HOSTS = \"*\": اكتب عنوان السيرفر واسمه في DJANGO_ALLOWED_HOSTS."

#: apps/core/health.py:100
msgid "The connection is protected"
msgstr "الاتصال محمي"

#: apps/core/health.py:101
msgid "HTTPS is on."
msgstr "HTTPS شغال."

#: apps/core/health.py:101
msgid ""
"On the clinic's own network. Turn HTTPS on (DJANGO_HTTPS=1) before the "
"branches or the internet reach the server."
msgstr ""
"على شبكة العيادة نفسها. شغّل HTTPS (DJANGO_HTTPS=1) قبل ما الفروع أو "
"الإنترنت يوصلوا للسيرفر."

#: apps/core/health.py:103
msgid ""
"Turn HTTPS on (DJANGO_HTTPS=1) before opening the system outside the clinic."
msgstr "شغّل HTTPS (DJANGO_HTTPS=1) قبل ما تفتح النظام برّه العيادة."

#: apps/core/health.py:105
msgid "A PC left open logs out by itself"
msgstr "الجهاز اللي يتساب مفتوح بيخرج لوحده"

#: apps/core/health.py:106
#, python-format
msgid "After %(n)s minutes without use."
msgstr "بعد %(n)s دقيقة من غير استخدام."

#: apps/core/health.py:107
msgid "Set the minutes in Settings → Clinic options (e.g. 60)."
msgstr "حط عدد الدقايق في الإعدادات ← خيارات العيادة (مثلًا 60)."

#: apps/core/health.py:110
msgid "Nobody logs in with an easy password"
msgstr "محدش بيدخل بكلمة سر سهلة"

#: apps/core/health.py:111
msgid ""
"The passwords seen at the logins are not short, common or like the username."
msgstr ""
"كلمات السر اللي اتشافت وقت الدخول مش قصيرة ولا مشهورة ولا شبه اسم المستخدم."

#: apps/core/health.py:112
#, python-format
msgid ""
"Easy passwords: %(names)s. Ask them to change it (user menu → Change "
"password), or tick \"people with an easy password must change it\" in Clinic"
" options."
msgstr ""
"كلمات سر سهلة: %(names)s. اطلب منهم يغيّروها (قائمة المستخدم ← تغيير كلمة "
"السر)، أو علّم على «اللي كلمة سره سهلة لازم يغيّرها» في خيارات العيادة."

#: apps/core/health.py:118
msgid "The data is backed up every night"
msgstr "البيانات بتتحفظ نسخة كل ليلة"

#: apps/core/health.py:119
#, python-format
msgid "Last backup %(when)s."
msgstr "آخر نسخة %(when)s."

#: apps/core/health.py:121
msgid ""
"No backup in the last day and a half: see Settings → Backup (the nightly "
"task must run)."
msgstr ""
"مفيش نسخة في آخر يوم ونص: شوف الإعدادات ← النسخ الاحتياطي (لازم المهمة "
"الليلية تشتغل)."

#: apps/core/health.py:122
msgid "The last backup was opened again and checked"
msgstr "آخر نسخة اتفتحت تاني واتراجعت"

#: apps/core/health.py:123
#, python-format
msgid "%(n)s records read back from it."
msgstr "%(n)s سجل اتقروا منها تاني."

#: apps/core/health.py:124
msgid "The last backup was not checked: make one now in Settings → Backup."
msgstr ""
"آخر نسخة ما اتراجعتش: اعمل نسخة دلوقتي من الإعدادات ← النسخ الاحتياطي."

#: apps/core/health.py:126
msgid "A second copy of each backup is kept on another disk"
msgstr "نسخة تانية من كل باك أب على هارد تاني"

#: apps/core/health.py:127
#, python-format
msgid "Copied to %(where)s."
msgstr "اتنسخت في %(where)s."

#: apps/core/health.py:128
msgid ""
"Set BACKUP_COPY_DIR to another disk or a network folder, and keep a second "
"disk outside the clinic."
msgstr ""
"حط BACKUP_COPY_DIR على هارد تاني أو فولدر على الشبكة، وخلّي هارد تاني برّه "
"العيادة."

#: apps/core/health.py:129
msgid "The photos are copied every night"
msgstr "الصور بتتنسخ كل ليلة"

#: apps/core/health.py:130
#, python-format
msgid "Only the new photos are copied, to %(where)s."
msgstr "الصور الجديدة بس هي اللي بتتنسخ، في %(where)s."

#: apps/core/health.py:132
msgid "The copy of the photos has not run in the last day and a half."
msgstr "نسخ الصور ما اشتغلش في آخر يوم ونص."

#: apps/core/health.py:134
msgid "There is room on the disk"
msgstr "فيه مكان فاضي على الهارد"

#: apps/core/health.py:135
#, python-format
msgid "%(free)s GB free of %(total)s GB."
msgstr "%(free)s جيجا فاضيين من %(total)s جيجا."

#: apps/core/health.py:136
#, python-format
msgid "Only %(free)s GB free: move old backups or add a disk soon."
msgstr "فاضي %(free)s جيجا بس: انقل النسخ القديمة أو زوّد هارد قريب."

#: apps/core/hints.py:16
msgid ""
"The lab's day: receive a case, check in the work coming from our clinics, "
"and tell the doctors on WhatsApp. The numbers open the lists behind them."
msgstr ""
"يوم المعمل: استلم حالة، واستلم الشغل الجاي من عياداتنا، وبلّغ الدكاترة على "
"واتساب. الأرقام بتفتح القوائم اللي وراها."

#: apps/core/hints.py:18
msgid ""
"The cases given to you are under With me now. Open one and press Done when "
"your step is finished."
msgstr ""
"الحالات اللي معاك تحت «معايا دلوقتي». افتح الحالة واضغط «خلصت» لما مرحلتك "
"تخلص."

#: apps/core/hints.py:19
msgid ""
"Start here: find a patient with the search box, or tap a big button. Below "
"them you see who comes next and who is waiting."
msgstr ""
"ابدأ من هنا: ابحث عن المريض في خانة البحث، أو اضغط أحد الأزرار الكبيرة. "
"تحتها ترى من سيأتي بعد ذلك ومن ينتظر."

#: apps/core/hints.py:21
msgid ""
"Your week is below: tap a patient to open the visit page. The bell at the "
"top rings when your patient arrives."
msgstr ""
"أسبوعك بالأسفل: اضغط على المريض لفتح صفحة الزيارة. الجرس بالأعلى يرن عند "
"وصول مريضك."

#: apps/core/hints.py:23
msgid ""
"Items running low and expiring soon are listed here. Tap one to receive or "
"take out stock."
msgstr ""
"الأصناف التي قاربت على النفاد أو قرب انتهاء صلاحيتها هنا. اضغط على صنف "
"للاستلام أو الصرف."

#: apps/core/hints.py:24
msgid "The numbers are live: tap a box to open the list behind it."
msgstr "الأرقام تتحدث أولًا بأول: اضغط على أي مربع لفتح القائمة التي خلفه."

#: apps/core/hints.py:25
msgid ""
"A summary of each place today. Press Open on a place (or choose it at the "
"top) to see only that place; All places brings this summary back."
msgstr ""
"ملخص كل مكان النهارده. اضغط «افتح» على أي مكان (أو اختاره من فوق) عشان تشوف "
"المكان ده بس؛ «كل الأماكن» يرجّع الملخص ده."

#: apps/core/hints.py:28
msgid ""
"Tap a notification to open what it is about. New ones are marked in blue."
msgstr "اضغط على التنبيه لفتح موضوعه. التنبيهات الجديدة عليها علامة زرقاء."

#: apps/core/hints.py:29
msgid ""
"Changes made at the reception wait here. Compare the old and the new values,"
" then approve or refuse."
msgstr "تعديلات الاستقبال تنتظر هنا. قارن القديم بالجديد، ثم وافق أو ارفض."

#: apps/core/hints.py:30
msgid ""
"Type part of a name, a mobile or a file number. Tap a row to open the "
"patient's file."
msgstr ""
"اكتب جزءًا من الاسم أو الموبايل أو رقم الملف. اضغط على السطر لفتح ملف "
"المريض."

#: apps/core/hints.py:31
msgid ""
"Start with the ID card: press Camera and hold the card in the frame (or "
"choose a photo). The number, the name, the address and the birth date are "
"read and written in yellow: check them. Fields with a red * are needed."
msgstr ""
"ابدئي بالبطاقة: اضغطي «الكاميرا» وحطي البطاقة جوه الإطار (أو اختاري صورة). "
"الرقم القومي والاسم والعنوان وتاريخ الميلاد بيتقروا ويتكتبوا بالأصفر: "
"راجعيهم. الخانات اللي عليها * حمرا لازم تتملى."

#: apps/core/hints.py:35
msgid ""
"The file step by step: the yellow button opens the next step. Record opens a"
" treatment, a surgery chart, a request or a prescription."
msgstr ""
"الملف خطوة بخطوة: الزرار الأصفر بيفتح الخطوة الجاية. «تسجيل» بيفتح علاج أو "
"شارت عملية أو طلب أو روشتة."

#: apps/core/hints.py:37
msgid ""
"Everything about this patient is on this page. The buttons at the top book, "
"bill and print."
msgstr ""
"كل ما يخص المريض في هذه الصفحة. الأزرار بالأعلى للحجز والفاتورة والطباعة."

#: apps/core/hints.py:39
msgid ""
"Patients whose readings need a physician's opinion before surgery, the "
"letters waiting for an answer, and the surgeries postponed for a medical "
"reason."
msgstr ""
"المرضى اللي قراياتهم محتاجة رأي طبيب باطنة قبل العملية، والخطابات اللي "
"مستنية رد، والعمليات اللي اتأجلت لسبب طبي."

#: apps/core/hints.py:41
msgid ""
"The letter is written from the medical history: tick the procedure, check "
"the medicines, then save and print it for the patient."
msgstr ""
"الخطاب بيتكتب من التاريخ المرضي: علّم العملية، وراجع الأدوية، وبعدين احفظه "
"واطبعه للمريض."

#: apps/core/hints.py:43
msgid ""
"Print the letter for the patient. When he brings the answer back, record it "
"with a photo of the paper: the dentist is told."
msgstr ""
"اطبع الخطاب للمريض. لما يرجع بالرد، سجّله مع صورة الورقة: الطبيب بيوصله "
"إشعار."

#: apps/core/hints.py:45
msgid ""
"Tap what you did today: the impression, the scan or the CBCT. Or skip it: it"
" is not needed for every patient."
msgstr ""
"اضغط على اللي عملته النهارده: الطبعة أو المسح أو الأشعة المقطعية. أو فوّتها:"
" مش كل مريض محتاجها."

#: apps/core/hints.py:47
msgid ""
"People who called but have no file yet. When one comes in, open the call and"
" turn it into a patient file in one click."
msgstr ""
"أشخاص اتصلوا وليس لهم ملف بعد. عندما يحضر أحدهم، افتح المكالمة وحوّلها إلى "
"ملف مريض بضغطة واحدة."

#: apps/core/hints.py:49
msgid ""
"Lists of patients to call, sent by the dentists or the heads. Open a list, "
"call each patient and write the answer."
msgstr ""
"قوائم مرضى للاتصال بهم، أرسلها الأطباء أو المسؤولون. افتح القائمة، اتصل بكل "
"مريض واكتب رده."

#: apps/core/hints.py:51
msgid ""
"Tap Arrived when the patient comes in, then In the room and Left. The panel "
"at the top follows the clock of this computer."
msgstr ""
"اضغط «وصل» عند حضور المريض، ثم «دخل الغرفة» و«انصرف». اللوحة بالأعلى تتبع "
"ساعة هذا الجهاز."

#: apps/core/hints.py:53
msgid ""
"One column per room (or per doctor: By doctor), in 15-minute steps. Tap a "
"green place to book it, or tap a booking to open it."
msgstr ""
"عمود لكل غرفة (أو لكل طبيب: حسب الطبيب)، كل ربع ساعة. اضغط على مكان أخضر "
"للحجز فيه، أو على حجز لفتحه."

#: apps/core/hints.py:55
msgid ""
"Choose the patient and the dentist, then tap a green place in the day grid "
"under the form, or use Nearest free times."
msgstr ""
"اختر المريض والطبيب، ثم اضغط على مكان أخضر في جدول اليوم أسفل النموذج، أو "
"استخدم «أقرب مواعيد فاضية»."

#: apps/core/hints.py:58
msgid ""
"Your appointments. Tap one to open the visit page and record what was done."
msgstr "مواعيدك. اضغط على موعد لفتح صفحة الزيارة وتسجيل ما تم."

#: apps/core/hints.py:59
msgid "Filter by day, dentist or status. Tap an appointment to open it."
msgstr "اختر اليوم أو الطبيب أو الحالة. اضغط على الموعد لفتحه."

#: apps/core/hints.py:62
msgid "Your shifts: which room and which hours, and the surgery days."
msgstr "شيفتاتك: أي غرفة وأي ساعات، وأيام العمليات."

#: apps/core/hints.py:63
msgid ""
"Who works in which room this week. Add a shift, or fill the week from last "
"week in one click."
msgstr ""
"من يعمل في أي غرفة هذا الأسبوع. أضف شيفت، أو املأ الأسبوع مثل الأسبوع الماضي"
" بضغطة واحدة."

#: apps/core/hints.py:65
msgid ""
"Tap Send: WhatsApp opens with the message ready. Press send there, then come"
" back for the next one."
msgstr ""
"اضغط «إرسال»: يفتح واتساب والرسالة جاهزة. أرسلها من هناك، ثم ارجع للرسالة "
"التالية."

#: apps/core/hints.py:67
msgid ""
"Patients waiting for a place. When a place frees up, you are told who to "
"call."
msgstr "مرضى ينتظرون مكانًا. عندما يفرغ مكان، يُقال لك بمن تتصل."

#: apps/core/hints.py:68
msgid ""
"Follow the tiles in order: the treatment or the surgery chart first, then "
"the prescription and the instructions."
msgstr ""
"اتبع المربعات بالترتيب: العلاج أو شارت العملية أولًا، ثم الروشتة والتعليمات."

#: apps/core/hints.py:70
msgid ""
"Add the patients you want on your days, with the step and the time needed. "
"The supervisor approves the list, then the reception calls them."
msgstr ""
"أضف المرضى الذين تريدهم في أيامك، مع الخطوة والوقت المطلوب. يوافق المشرف على"
" القائمة، ثم يتصل بهم الاستقبال."

#: apps/core/hints.py:72
msgid ""
"Call the patients in order. Book fills the booking form in one step; if one "
"cannot come, the page says who to call instead."
msgstr ""
"اتصل بالمرضى بالترتيب. «احجز» يملأ نموذج الحجز مرة واحدة؛ وإذا لم يستطع "
"أحدهم الحضور، تخبرك الصفحة بمن تتصل بدلًا منه."

#: apps/core/hints.py:74
msgid ""
"Every treatment recorded. Filter by dentist or date, and tap a row for the "
"details."
msgstr ""
"كل العلاجات المسجلة. اختر الطبيب أو التاريخ، واضغط على السطر للتفاصيل."

#: apps/core/hints.py:75
msgid ""
"Choose the patient and the teeth first: each tooth shows how it is now, what"
" was done and what is planned, and the kinds of work that fit come first. "
"Then the step."
msgstr ""
"اختر المريض والأسنان أولاً: كل سن يظهر حاله الآن وما عُمل وما هو مخطط، "
"وأنواع الشغل المناسبة تظهر أولاً. بعدها الخطوة."

#: apps/core/hints.py:77
msgid ""
"Take the photos and periapical X-rays this step needs: each box opens the "
"tablet's camera."
msgstr ""
"صوّر الصور والأشعة الصغيرة اللي الخطوة محتاجاها: كل خانة بتفتح كاميرا "
"التابلت."

#: apps/core/hints.py:79
msgid ""
"Each lab work from the request to the fitting. Late work is marked in red."
msgstr "كل شغل معمل من الطلب حتى التركيب. الشغل المتأخر باللون الأحمر."

#: apps/core/hints.py:80
msgid ""
"Visits with nothing written in the patient's file. Open each one and record "
"what was done."
msgstr "زيارات لم يُكتب عنها شيء في ملف المريض. افتح كل واحدة وسجّل ما تم."

#: apps/core/hints.py:82
msgid ""
"Tap a tooth to see its history. The buttons above the chart open the "
"examination, the plan and the photos."
msgstr ""
"اضغط على السن لترى تاريخه. الأزرار فوق الشارت تفتح الكشف والخطة والصور."

#: apps/core/hints.py:84
msgid ""
"The implant and surgery part of the plans. Choose the filters, then send the"
" patients found to the reception to call them."
msgstr ""
"جزء الزرع والجراحة من الخطط. اختار الفلاتر، وبعدين ابعت المرضى للاستقبال "
"يتصلوا بيهم."

#: apps/core/hints.py:86
msgid ""
"The restorative part of the plans (crowns, fillings, root canals, "
"dentures…). Choose the filters, then send the patients to the reception."
msgstr ""
"الجزء التعويضي والعلاجي من الخطط (تيجان، حشوات، علاج عصب، أطقم…). اختار "
"الفلاتر، وبعدين ابعت المرضى للاستقبال."

#: apps/core/hints.py:88
msgid ""
"Every restorative step of the treatment log. Tap a group button for the "
"statistics, or a kind of work to see only its steps."
msgstr ""
"كل خطوات العلاج التعويضي والعلاجي المسجلة. اضغط زرار تجميع للإحصائيات، أو "
"نوع عمل لعرض خطواته فقط."

#: apps/core/hints.py:90
msgid "Every surgery chart. Tap one to open it, or start a new surgery chart."
msgstr "كل شارتات العمليات. اضغط على واحد لفتحه، أو ابدأ شارت عملية جديدًا."

#: apps/core/hints.py:91
msgid ""
"Choose a tool (implant, pontic, extraction...) and tap the teeth, like on a "
"scanner. Choose the implant company once, then the sizes and lots implant by"
" implant."
msgstr ""
"اختار أداة (زرعة، سنة معلّقة، خلع...) واضغط على الأسنان، زي برنامج السكانر. "
"اختار شركة الزرعات مرة واحدة، وبعدين المقاسات والتشغيلات زرعة زرعة."

#: apps/core/hints.py:93
msgid ""
"Tap the teeth to change the design; each tooth's details are in the list "
"below it."
msgstr ""
"اضغط على الأسنان عشان تغيّر التصميم؛ تفاصيل كل سنة في القائمة اللي تحته."

#: apps/core/hints.py:94
msgid ""
"Tap each point as you do it and write the torque. Save it as delivered at "
"the end: the implants become loaded on the chart."
msgstr ""
"اضغط على كل نقطة وانت بتعملها واكتب العزم. في الآخر احفظها «اتسلّمت»: "
"الزرعات بتبقى محمّلة على الشارت."

#: apps/core/hints.py:96
msgid ""
"Choose filters, then group by one or two columns for the statistics. Export "
"to Excel for publications."
msgstr ""
"اختر الفلاتر، ثم جمّع بعمود أو اثنين للإحصائيات. صدّر إلى إكسل للنشر العلمي."

#: apps/core/hints.py:98
msgid ""
"Open complaints come first. Tap one: it opens here with its story, and you "
"can write a comment at once. The number opens the whole complaint."
msgstr ""
"الشكاوى المفتوحة أولًا. اضغطي على شكوى: هتتفتح هنا بتفاصيلها وتقدري تكتبي "
"تعليق على طول. رقم الشكوى يفتح الشكوى كاملة."

#: apps/core/hints.py:100
msgid ""
"Choose the patient first: his earlier complaints show. The same problem "
"again? Press He called again on it instead of writing a new one."
msgstr ""
"اختاري المريض الأول: شكاويه القديمة هتظهر. نفس المشكلة تاني؟ اضغطي «اتصل "
"تاني عليها» بدل ما تكتبي شكوى جديدة."

#: apps/core/hints.py:102
msgid ""
"The candidates by batch: regular or private, online or in the academy. Tap "
"one for the enrollment, the installments, the implants and the days he came."
msgstr ""
"المرشحون حسب الدفعة: عادية أو خاصة، أونلاين أو في الأكاديمية. اضغطي على واحد"
" لتسجيله والأقساط والزرعات والأيام اللي حضرها."

#: apps/core/hints.py:104
msgid ""
"What each candidate pays this month. Tap the WhatsApp button to remind them."
msgstr "المطلوب من كل دارس هذا الشهر. اضغط زر واتساب لتذكيره."

#: apps/core/hints.py:105
msgid ""
"Installments past their date. Call or send a WhatsApp reminder, then record "
"the payment."
msgstr "أقساط فات موعدها. اتصل أو أرسل تذكير واتساب، ثم سجّل الدفع."

#: apps/core/hints.py:106
msgid ""
"Tap a quick button for the usual services, or add lines yourself. Tick Pay "
"now to take the money at once."
msgstr ""
"اضغط زرًا سريعًا للخدمات المعتادة، أو أضف السطور بنفسك. علّم «ادفع الآن» "
"لتحصيل المبلغ فورًا."

#: apps/core/hints.py:108
msgid ""
"Bills to collect are at the top. Tap a bill to take a payment or print it."
msgstr ""
"الفواتير التي لم تُحصّل بعد بالأعلى. اضغط على الفاتورة لتحصيلها أو طباعتها."

#: apps/core/hints.py:109
msgid ""
"The day's collections by payment method are at the top. Tap a payment to "
"print its receipt."
msgstr "تحصيل اليوم حسب طريقة الدفع بالأعلى. اضغط على الدفعة لطباعة الإيصال."

#: apps/core/hints.py:111
msgid ""
"All the receipts of the day at this place. Before you leave, count the cash "
"in the drawer and close the day. A receipt written by mistake is cancelled "
"from the receipt itself."
msgstr ""
"كل إيصالات اليوم في هذا المكان. قبل أن تنصرف، عُدّ النقدية في الدرج وأغلق "
"اليوم. الإيصال المكتوب بالخطأ يُلغى من الإيصال نفسه."

#: apps/core/hints.py:113
msgid ""
"The day's receipts, bills and changes. Tick the day as reviewed when it is "
"right."
msgstr ""
"إيصالات وفواتير وتعديلات اليوم. علّم اليوم كمُراجَع عندما يكون صحيحًا."

#: apps/core/hints.py:115
msgid ""
"Each day of the month with its total, whether it was closed and reviewed, "
"and the difference in the drawer. Tap a day to open it."
msgstr ""
"كل يوم في الشهر بإجماليه، وهل أُغلق وروجع، وفرق الدرج. اضغط على يوم لفتحه."

#: apps/core/hints.py:117
msgid ""
"Correct the amount or the way of paying, cancel a receipt written by "
"mistake, or give money back. Write why: the owner sees every change."
msgstr ""
"صحّح المبلغ أو طريقة الدفع، أو ألغِ إيصالًا كُتب بالخطأ، أو رُدّ مبلغًا. "
"اكتب السبب: المالك يرى كل تعديل."

#: apps/core/hints.py:120
msgid ""
"The reception is told of this bill and takes the payment. Press WhatsApp to "
"ask the reception to send it to the patient."
msgstr ""
"يُبلَّغ الاستقبال بهذه الفاتورة ويأخذ الدفع. اضغط واتساب لتطلب من الاستقبال "
"إرسالها للمريض."

#: apps/core/hints.py:122
msgid "Take the payment under the bill; the receipt opens after saving."
msgstr "خذ الدفع تحت الفاتورة؛ يفتح الإيصال بعد الحفظ."

#: apps/core/hints.py:124
msgid ""
"Print the request for the patient. When the scan is done, press Done here or"
" at the centre and write the folder of the scan: it then opens with one "
"click."
msgstr ""
"اطبع الطلب للمريض. عندما تتم الأشعة، اضغط تمت هنا أو في المركز واكتب مجلد "
"الأشعة: تفتح بعدها بضغطة واحدة."

#: apps/core/hints.py:126
msgid ""
"Ask the questions in order and tick the answers. Save and go on: the file "
"goes step by step to the dental history, the examination and the plan."
msgstr ""
"اسأل الأسئلة بالترتيب وعلّم الإجابات. احفظ وتابع: الملف يمشي خطوة بخطوة إلى "
"تاريخ الأسنان ثم الكشف ثم خطة العلاج."

#: apps/core/hints.py:128
msgid ""
"Draw a frame to crop (4:3 fits the log book), turn or mirror, then save. The"
" original photo is kept and can be put back."
msgstr ""
"ارسم إطارًا للقص (4:3 يناسب الـ log book)، دوّر أو اعكس، ثم احفظ. الصورة "
"الأصلية محفوظة ويمكن إرجاعها."

#: apps/core/hints.py:130
msgid ""
"The stock is in groups (dental, implants, beverage, stationery...), each "
"with its categories. Add or rename a category here; the clock button shows "
"its movements."
msgstr ""
"المخزن مقسم إلى مجموعات (مواد أسنان، زرعات، مشروبات، أدوات مكتبية...)، ولكل "
"مجموعة أقسامها. أضف أو غيّر اسم قسم من هنا؛ زر الساعة يعرض حركته."

#: apps/core/hints.py:132
msgid ""
"Card payments appear here by themselves. Add bills paid on the machine, "
"money put on it and Fawry's transfers to the bank."
msgstr ""
"مدفوعات الكارت تظهر هنا تلقائيًا. أضف الفواتير المدفوعة على الماكينة، "
"والمبالغ الموضوعة عليها، وتحويلات فوري إلى البنك."

#: apps/core/hints.py:134
msgid ""
"The people in groups (the tabs). Take off the lists someone who comes "
"rarely: his work stays. Candidates leave the lists when their course ends."
msgstr ""
"الناس في مجموعات (التبويبات). شيل من القوائم اللي بيجي نادراً: شغله يفضل. "
"المرشحون يخرجوا من القوائم لما دورتهم تخلص."

#: apps/core/hints.py:136
msgid ""
"Red rows are below their reorder level. Tap an item to receive, take out or "
"count it."
msgstr ""
"السطور الحمراء تحت حد الطلب. اضغط على الصنف للاستلام أو الصرف أو الجرد."

#: apps/core/hints.py:137
msgid ""
"Choose who takes the items, then add one line per item. The stock goes down "
"when you save."
msgstr "اختر من سيستلم الأصناف، ثم سطرًا لكل صنف. ينقص المخزن عند الحفظ."

#: apps/core/hints.py:138
msgid "Every stock movement, with who and for whom. Filter by item or date."
msgstr "كل حركة في المخزن، من قام بها ولمن. اختر الصنف أو التاريخ."

#: apps/core/hints.py:139
msgid ""
"What was bought at a new price: the last price against the one before. Tap "
"an item for all its prices."
msgstr ""
"الأصناف اللي اتشرت بسعر جديد: آخر سعر قصاد اللي قبله. اضغط على صنف لعرض كل "
"أسعاره."

#: apps/core/hints.py:141
msgid ""
"Items given back to the suppliers. The open ones come first: tap one to "
"finish its next step."
msgstr ""
"الأصناف المرتجعة للموردين. المفتوحة الأول: اضغط على مرتجع لتكملة الخطوة "
"الجاية."

#: apps/core/hints.py:143
msgid ""
"Write how many of each item go back and why. They go out of the stock when "
"you save."
msgstr "اكتب عدد كل صنف هيرجع وليه. بيخرجوا من المخزن أول ما تحفظ."

#: apps/core/hints.py:145
msgid ""
"Sign once in the box: your signature is printed on the receipts and the "
"prescriptions."
msgstr "امضي مرة واحدة في المربع: توقيعك بيتطبع على الإيصالات والروشتات."

#: apps/core/hints.py:146
msgid ""
"The purchases of the place chosen in the tabs, dental or not, then by group."
" Tap one for its lines and invoice photo."
msgstr ""
"مشتريات المكان المختار في التبويبات، أسنان أو غير أسنان، وبعدين حسب "
"المجموعة. اضغط على واحدة لسطورها وصورة الفاتورة."

#: apps/core/hints.py:148
msgid ""
"Add one line per item with its category. Link a line to a stock item to fill"
" the stock."
msgstr "أضف سطرًا لكل صنف مع فئته. اربط السطر بصنف في المخزن ليزيد المخزن."

#: apps/core/hints.py:149
msgid ""
"Choose a report. Each one can be filtered by dates, and most can be "
"exported."
msgstr "اختر تقريرًا. كل تقرير يمكن تحديد تواريخه، وأغلبها يمكن تصديره."

#: apps/core/hints.py:150
msgid ""
"The main settings first, then each place (its people, rooms, services and "
"look), then the lists: type in Find a list to reach one quickly. Nothing is "
"deleted: untick active instead."
msgstr ""
"الإعدادات الأساسية الأول، بعدها كل مكان (ناسه وأوضه وخدماته وشكله)، وبعدها "
"القوائم: اكتب في «دوّر على قائمة» عشان توصل لها بسرعة. مفيش حاجة بتتمسح: شيل"
" علامة «نشط» بدل كده."

#: apps/core/hints.py:152
msgid ""
"Choose a role on the side, then for each part: Normal, Read only or No "
"access. Save once for every role."
msgstr ""
"اختار الدور من الجنب، وبعدين لكل جزء: عادي، أو قراءة فقط، أو ممنوع. واحفظ "
"مرة واحدة لكل الأدوار."

#: apps/core/hints.py:154
msgid ""
"Choose a place to see only its people. The lab shows the dentists who design"
" for it too."
msgstr ""
"اختار مكان عشان تشوف ناسه بس. المعمل بيظهر فيه كمان الدكاترة اللي بيعملوا له"
" ديزاين."

#: apps/core/hints.py:155
msgid ""
"For each person: how many times they opened the system, how long it was open"
" and how long they worked. Tap a name to see each time."
msgstr ""
"لكل واحد: فتح النظام كام مرة، وفضل مفتوح قد إيه، واشتغل قد إيه. اضغط على "
"الاسم عشان تشوف كل مرة."

#: apps/core/hints.py:157
msgid ""
"Each time this person opened the system: when, how long it stayed open, how "
"long they worked and how it ended."
msgstr ""
"كل مرة الشخص ده فتح فيها النظام: إمتى، وفضل مفتوح قد إيه، واشتغل قد إيه، "
"وانتهت إزاي."

#: apps/core/hints.py:159
msgid ""
"The lab's receipts of the day and the work delivered. At the end of the day "
"count the cash in the drawer and close the day; the owner reviews it."
msgstr ""
"إيصالات المعمل النهارده والشغل اللي اتسلم. آخر اليوم عِد الفلوس اللي في "
"الدرج وقفّل اليوم؛ وصاحب المكان بيراجعه."

#: apps/core/hints.py:161
msgid ""
"Green means the last backup worked. Every night the data is saved as a ZIP "
"and the new photos are copied to the backup disk. Make a backup now before "
"any big change."
msgstr ""
"الأخضر يعني أن آخر نسخة احتياطية تمت بنجاح. كل ليلة تُحفظ البيانات في ملف "
"ZIP وتُنسخ الصور الجديدة إلى هارد النسخ الاحتياطي. اعمل نسخة احتياطية الآن "
"قبل أي تغيير كبير."

#: apps/core/hints.py:163
msgid ""
"A yellow line is something to fix, with how. Below: who is logged in now, "
"the logins closed after wrong passwords (Open lets them try again) and "
"everything done with the logins and the files taken out."
msgstr ""
"السطر الأصفر حاجة لازم تتصلّح، ومكتوب إزاي. وتحت: مين داخل دلوقتي، والدخول "
"اللي اتقفل بعد كلمات سر غلط (افتح بيخليهم يحاولوا تاني)، وكل اللي حصل في "
"الدخول والملفات اللي اتنزّلت."

#: apps/core/hints.py:166
msgid ""
"Whatever anyone deletes is kept here for a year: open a line to see what it "
"held, then write it again if it was a mistake."
msgstr ""
"أي حاجة حد بيمسحها بتتحفظ هنا سنة: افتح السطر تشوف كان فيه إيه، واكتبه تاني "
"لو اتمسح بالغلط."

#: apps/core/hints.py:168
msgid ""
"Problems told by the staff, and pages that stopped with an error (written "
"down by themselves). Mark each one when it is being looked at or solved."
msgstr ""
"المشاكل التي أبلغ عنها الموظفون، والصفحات التي توقفت بخطأ (تُسجَّل وحدها). "
"حدّد حالة كل مشكلة عند متابعتها أو حلها."

#: apps/core/hints.py:170
msgid ""
"Each doctor of the place: visits, time in the chair, what the patients paid "
"and the doctor's share. Tap a doctor for the details and to record a payment"
" to them."
msgstr ""
"كل طبيب في المكان: الزيارات، ووقت الكرسي، وما دفعه المرضى، ونصيب الطبيب. "
"اضغط على الطبيب للتفاصيل ولتسجيل مبلغ دُفع له."

#: apps/core/hints.py:173
msgid ""
"Your services and visits at this place, the share of each one, and what you "
"were paid."
msgstr "خدماتك وزياراتك في هذا المكان، ونصيبك من كل منها، وما تم دفعه لك."

#: apps/core/hints.py:174
msgid ""
"Every service and visit of the doctor with its share. Record each payment to"
" the doctor under the list: what is still owed goes down."
msgstr ""
"كل خدمة وزيارة للطبيب مع نصيبه منها. سجّل كل مبلغ يُدفع للطبيب أسفل القائمة:"
" فيقل المتبقي له."

#: apps/core/hints.py:177
msgid ""
"How each doctor is paid: a percentage, a fixed amount for each service (each"
" tooth) or for each visit. To change it from a date, add a new rule from "
"that date."
msgstr ""
"طريقة محاسبة كل طبيب: نسبة، أو مبلغ ثابت لكل خدمة (لكل سن) أو لكل زيارة. "
"لتغييرها من تاريخ معين، أضف قاعدة جديدة من هذا التاريخ."

#: apps/core/hints.py:179
msgid ""
"The place over the period: what the patients paid, visits and time, the "
"doctors' shares, the materials used, and what is left for the clinic."
msgstr ""
"المكان خلال الفترة: ما دفعه المرضى، والزيارات والوقت، وأنصبة الأطباء، "
"والخامات المستخدمة، وما يتبقى للعيادة."

#: apps/core/hints.py:181
msgid ""
"A doctor's own price for a service (e.g. the TMJ specialist's examination) "
"and its usual lab or implant cost. His bills take this price by themselves."
msgstr ""
"سعر خاص بالطبيب لخدمة (مثلًا كشف أخصائي المفصل) وتكلفة المعمل أو الزرعة "
"المعتادة لها. فواتيره تاخد السعر ده لوحدها."

#: apps/core/hints.py:183
msgid ""
"The specialists' charts at this place: endodontics, TMJ, orthodontics and "
"shades. Tap a row to open it; new ones start from the patient's file → "
"Specialists."
msgstr ""
"ملفات الأخصائيين في المكان ده: العصب، مفصل الفك، التقويم، والألوان. اضغط على"
" سطر لفتحه؛ الجديد يبدأ من ملف المريض ← الأخصائيون."

#: apps/core/hints.py:186
msgid ""
"The patient's referrals. Tap Book on a referral to book the patient with the"
" specialist."
msgstr "تحويلات المريض. اضغط احجز على التحويل لحجز المريض مع الأخصائي."

#: apps/core/hints.py:187
msgid ""
"Refer the patient, or open a specialist's chart. The referrals and every "
"chart of the patient are listed below."
msgstr "حوّل المريض، أو افتح ملف أخصائي. التحويلات وكل ملفات المريض تحت."

#: apps/core/hints.py:191
msgid ""
"Referrals to book: open one and tap Book, the specialist and the patient are"
" filled in."
msgstr ""
"تحويلات مطلوب حجزها: افتح واحد واضغط احجز، الأخصائي والمريض بيتكتبوا لوحدهم."

#: apps/core/hints.py:192
msgid ""
"The referrals of this place: the ones sent to you, the ones you sent, and "
"their answers."
msgstr "تحويلات المكان ده: اللي اتبعتت لك، واللي انت بعتها، وردودها."

#: apps/core/hints.py:195
msgid ""
"Book the patient with the specialist from here, and print the letter for the"
" patient."
msgstr "احجز المريض مع الأخصائي من هنا، واطبع الخطاب للمريض."

#: apps/core/hints.py:196
msgid ""
"The letter prints with the place's letterhead. The specialist writes his "
"answer at the bottom: the referring doctor is told."
msgstr ""
"الخطاب بيتطبع بترويسة المكان. الأخصائي بيكتب رده تحت، والطبيب اللي حوّل "
"بيوصله إشعار."

#: apps/core/hints.py:199
msgid ""
"Add each visit with the medication left in the canals. When the tooth is "
"obturated, tap Obturated: the dental chart shows the root canal."
msgstr ""
"أضف كل زيارة والحشو الدوائي اللي في القنوات. لما السن يتحشي نهائي اضغط \"تم "
"الحشو\": الشارت يظهر علاج العصب."

#: apps/core/hints.py:201
msgid ""
"Add each follow-up with the mouth opening and the pain: the bars show the "
"progress."
msgstr "أضف كل متابعة بفتحة الفم والألم: الأعمدة بتوضح التحسن."

#: apps/core/hints.py:202
msgid ""
"Add each adjustment visit: the wires of the last visit are filled in, change"
" what is new."
msgstr ""
"أضف كل زيارة ضبط: أسلاك الزيارة اللي فاتت بتتكتب لوحدها، غيّر الجديد بس."

#: apps/core/hints.py:203
msgid ""
"The shade of each third of the tooth for the ceramist. Tap Lab request to "
"send it with the work."
msgstr "لون كل ثلث من السن للفني. اضغط \"طلب معمل\" لإرساله مع الشغل."

#: apps/core/hints.py:206
msgid ""
"Every place side by side. Choose today, 7 days or this month; rest the mouse"
" on a column to see its number, or open Show the numbers."
msgstr ""
"كل الأماكن جنب بعض. اختار النهارده أو 7 أيام أو الشهر ده، وقف بالماوس على أي"
" عمود تشوف رقمه، أو افتح «اعرض الأرقام»."

#: apps/core/hints.py:209
msgid ""
"One column per step. Press the button under a case when its step is done: it"
" goes on to the next step, and to the person who does it."
msgstr ""
"عمود لكل مرحلة. اضغط الزرار اللي تحت الحالة لما مرحلتها تخلص: تروح للمرحلة "
"اللي بعدها وللشخص اللي بيعملها."

#: apps/core/hints.py:211
msgid ""
"One column per step. The cases with you have your name; press Done when your"
" step is finished."
msgstr ""
"عمود لكل مرحلة. الحالات اللي معاك عليها اسمك، واضغط «خلصت» لما مرحلتك تخلص."

#: apps/core/hints.py:214
msgid ""
"Choose the client and write the work: the price comes from the client's "
"price list and the steps from the kind of work. Then print the label for the"
" box."
msgstr ""
"اختار العميل واكتب الشغل: السعر بييجي من قائمة أسعار العميل، والمراحل من نوع"
" الشغل. بعد كده اطبع الملصق للعلبة."

#: apps/core/hints.py:216
msgid ""
"Work sent by CIA, CIC or El Khadem. When it arrives, tick what came with it "
"and press Received."
msgstr ""
"شغل باعته الأكاديمية أو CIC أو عيادة الخادم. لما يوصل علّم على اللي جه معاه "
"واضغط «استلمناه»."

#: apps/core/hints.py:218
msgid ""
"The big button moves the case to its next step. The bars show how long each "
"step took. A remake opens a new case linked to this one."
msgstr ""
"الزرار الكبير بينقل الحالة للمرحلة اللي بعدها. الأشرطة بتبيّن كل مرحلة خدت "
"قد إيه. الإعادة بتفتح حالة جديدة مربوطة بالحالة دي."

#: apps/core/hints.py:220
msgid ""
"The cases given to you. Press the button when your step is finished: the "
"next person is told."
msgstr ""
"الحالات اللي معاك. اضغط الزرار لما مرحلتك تخلص: اللي بعدك هيوصله تنبيه."

#: apps/core/hints.py:221
msgid ""
"Open a new block when you start it: then record on each case how many units "
"were milled from it, and close the block when it is finished."
msgstr ""
"افتح بلوك جديد لما تبدأ فيه، وبعد كده سجّل على كل حالة كام وحدة اتفرّزت منه،"
" واقفل البلوك لما يخلص."

#: apps/core/hints.py:223
msgid ""
"Each client with what was delivered, paid and still owed. Open one for its "
"cases, receipts and statement."
msgstr ""
"كل عميل واللي اتسلّمله واللي دفعه واللي لسه عليه. افتح أي عميل تشوف حالاته "
"وإيصالاته وكشف حسابه."

#: apps/core/hints.py:225
msgid ""
"Type the prices of each list and press Save. An empty box means no price for"
" that work."
msgstr ""
"اكتب أسعار كل قائمة واضغط حفظ. الخانة الفاضية معناها مفيش سعر للشغل ده."

#: apps/core/hints.py:226
msgid ""
"Every receipt of the lab. A mistake is cancelled with its reason (never "
"deleted)."
msgstr "كل إيصالات المعمل. الإيصال الغلط بيتلغي مع السبب (عمره ما بيتمسح)."

#: apps/core/hints.py:227
msgid ""
"The time each step takes, the people, the remakes and their reasons, the "
"blocks and the money. Change the dates to compare months."
msgstr ""
"الوقت اللي كل مرحلة بتاخده، والناس، والإعادات وأسبابها، والبلوكات، والفلوس. "
"غيّر التواريخ عشان تقارن الشهور."

#: apps/core/hints.py:229
msgid ""
"Type the case number or the doctor's mobile: the answer with the real status"
" is written for you. Press Send, then send it in WhatsApp."
msgstr ""
"اكتب رقم الحالة أو موبايل الدكتور: الرد بالحالة الحقيقية بيتكتب لوحده. اضغط "
"«ابعت» وبعدين ابعته من واتساب."

#: apps/core/hints.py:231
msgid ""
"Tick the steps each person does: a case goes by itself to the only person "
"who does a step."
msgstr ""
"علّم على المراحل اللي كل شخص بيعملها: الحالة بتروح لوحدها للشخص الوحيد اللي "
"بيعمل المرحلة."

#: apps/core/hints.py:233
msgid ""
"Messages to many patients. Make a new one, then send it one patient at a "
"time: WhatsApp opens with the message ready."
msgstr ""
"رسائل لمرضى كتير. اعملي رسالة جديدة، وبعدين ابعتيها لمريض مريض: الواتساب "
"يفتح والرسالة جاهزة."

#: apps/core/hints.py:235
#, python-brace-format
msgid ""
"Choose who receives it (by filters or by hand), then write the message. "
"{patient} is replaced by each patient's name."
msgstr ""
"اختاري مين يستلمها (بالفلاتر أو باليد)، وبعدين اكتبي الرسالة. {patient} "
"يتغير لاسم كل مريض."

#: apps/core/hints.py:237
msgid ""
"Press Send next to each patient: WhatsApp opens; send, then come back for "
"the next. Do not send more than about a hundred a day from one number."
msgstr ""
"اضغطي «إرسال» جنب كل مريض: الواتساب يفتح؛ ابعتي وارجعي للي بعده. ماتبعتيش "
"أكتر من حوالي مية في اليوم من رقم واحد."

#: apps/core/hints.py:239
msgid ""
"Tick the services to give back: the amount is filled for you, and the "
"original receipt shows. Write why, then save."
msgstr ""
"علّمي على الخدمات اللي هترجع فلوسها: المبلغ يتكتب لوحده، والإيصال الأصلي "
"ظاهر. اكتبي السبب وبعدين احفظي."

#: apps/core/hints.py:241
msgid ""
"Money the owner put in the drawer (when the day's costs are more than the "
"income), or took out. It shows in the day's closing and the balance sheet."
msgstr ""
"فلوس حطها المالك في الدرج (لما مصاريف اليوم تبقى أكتر من الدخل)، أو أخدها. "
"بتظهر في قفلة اليوم والميزانية."

#: apps/core/hints.py:243
msgid ""
"A CIA junior writes who supervised today's surgeries. Each surgery of the "
"day takes him as its instructor; he is printed on the case report and the "
"log book."
msgstr ""
"طبيب من أطباء CIA يكتب مين أشرف على جراحات اليوم. كل جراحة في اليوم تاخده "
"مشرفاً لها؛ واسمه يُطبع في تقرير الحالة وفي اللوج بوك."

#: apps/core/hints.py:245
msgid ""
"The life of this implant: each check (its class) and each complication in "
"detail. Add a check or a complication with the buttons."
msgstr ""
"حياة هذه الزرعة: كل فحص (وتصنيفه) وكل مضاعفة بالتفصيل. أضف فحصاً أو مضاعفة "
"بالأزرار."

#: apps/core/hints.py:247
msgid ""
"Write the findings: the class of the tissues around the implant is worked "
"out for you."
msgstr "اكتب نتائج الفحص: تصنيف الأنسجة حول الزرعة يُحسب لك."

#: apps/core/hints.py:248
msgid ""
"Choose the group and the kind, when it showed, the treatment and how it "
"ended. A removed or lost implant becomes failed on the chart."
msgstr ""
"اختر المجموعة والنوع، ومتى ظهرت، والعلاج، وكيف انتهت. الزرعة المشالة أو "
"المفقودة تصبح فاشلة على المخطط."

#: apps/core/hints.py:250
msgid "Choose the implant that was checked or has a complication."
msgstr "اختر الزرعة التي تم فحصها أو بها مضاعفة."

#: apps/core/hints.py:251
msgid ""
"Every implant complication of this place, by group and kind, for the follow-"
"up and for papers. Excel gives one line for each."
msgstr ""
"كل مضاعفات الزرعات في هذا المكان، حسب المجموعة والنوع، للمتابعة وللأبحاث. "
"ملف Excel يعطي سطراً لكل واحدة."

#: apps/core/hints.py:253
msgid ""
"The prosthodontic case: the missing teeth, the abutments, the occlusion, the"
" esthetics and the plan, with its shades and lab work."
msgstr ""
"حالة التركيبات: الأسنان المفقودة، الدعامات، الإطباق، الشكل الجمالي والخطة، "
"مع درجات اللون وشغل المعمل."

#: apps/core/hints.py:255
msgid ""
"Write the prosthodontic examination; the plan at the end is what the patient"
" agreed to. The shade is taken from the case page."
msgstr ""
"اكتب فحص التركيبات؛ الخطة في الآخر هي ما وافق عليه المريض. درجة اللون تؤخذ "
"من صفحة الحالة."

#: apps/core/hints.py:257
msgid ""
"The tooth boxes start as the dental chart is now: change only what you find "
"different. The chart above colours the teeth as you write them."
msgstr ""
"خانات الأسنان تبدأ كما هو المخطط الآن: غيّر فقط ما تجده مختلفاً. المخطط فوق "
"يلوّن الأسنان وأنت تكتبها."

#: apps/core/management/commands/send_reminders.py:30
#, python-format
msgid "Complaint %(number)s needs follow-up (overdue)"
msgstr "الشكوى %(number)s تحتاج متابعة (متأخرة)"

#: apps/core/management/commands/send_reminders.py:44
#, python-format
msgid "Lab work %(number)s is late at %(lab)s"
msgstr "شغل المعمل %(number)s متأخر في %(lab)s"

#: apps/core/mixins.py:38
msgid "Saved successfully."
msgstr "تم الحفظ بنجاح."

